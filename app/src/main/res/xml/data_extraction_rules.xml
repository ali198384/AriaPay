<?xml version="1.0" encoding="utf-8"?><!--
   Android 12+ backup and device-transfer rules.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- The session token must not be restored from cloud backup. -->
        <exclude domain="file" path="datastore/aria_session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <!-- Do not transfer the session token to another device. -->
        <exclude domain="file" path="datastore/aria_session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
